[Unit]
Description=Continuously enforce ROG Control profile from boot
# Headless hardware settings run before login. The enforcer retries GPU
# session settings when a graphical display becomes available.
After=rogcontrol-apply.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/rogcontrol-enforcer.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
