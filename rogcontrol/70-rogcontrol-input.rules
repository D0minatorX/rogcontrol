# Only the supported ASUS laptop keyboard and ASUS WMI hotkeys.
# uaccess grants access to the active local session, before 73-seat-late.rules.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Asus WMI hotkeys", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{id/vendor}=="0b05", ATTRS{id/product}=="19b6", TAG+="uaccess"
# Fn Lock needs a virtual keyboard. Never make input nodes world-writable.
SUBSYSTEM=="misc", KERNEL=="uinput", OPTIONS+="static_node=uinput", TAG+="uaccess"
