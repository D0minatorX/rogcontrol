#!/usr/bin/env python3
"""Qt system tray sidecar, sharing the app's existing profile request worker.

The sidecar survives closing the window and follows external config changes.
No GTK environment overrides are needed; children inherit the desktop session.
"""
import os
from pathlib import Path
import signal
import subprocess
import sys
import threading

_HERE = Path(__file__).resolve().parent
for _candidate in (_HERE.parent, Path.home() / '.local/lib'):
    if (_candidate / 'rogcontrol/__init__.py').is_file():
        if str(_candidate) not in sys.path:
            sys.path.insert(0, str(_candidate))
        break

try:
    from PySide6.QtCore import QObject, QTimer, Signal, Slot, Qt
    from PySide6.QtGui import QAction, QActionGroup, QIcon
    from PySide6.QtWidgets import QApplication, QMenu, QSystemTrayIcon
except ImportError as error:
    raise SystemExit('ROG Control tray needs PySide6 (Qt 6). Install the Qt runtime with the ROG Control installer.') from error

import rogcontrol
from rogcontrol import config as config_mod, profile_requests
from rogcontrol.profiles import DEFAULT_PROFILES

POLL_SECONDS = 5
QUIT_EXIT_CODE = 42
_PACKAGE = Path(rogcontrol.__file__).resolve().parent
_ICON_DIR = Path.home() / '.local/share/icons/hicolor/256x256/apps'
PROFILE_ICON_NAMES = {'Quiet': 'rogcontrol-quiet.png',
                      'Balanced Power': 'rogcontrol-balanced.png',
                      'Balanced Performance': 'rogcontrol-balanced.png',
                      'Performance': 'rogcontrol-Performance.png'}
DEFAULT_TRAY_ICON = 'rogcontrol-Performance.png'


def icon_for_profile(name):
    filename = PROFILE_ICON_NAMES.get(name, DEFAULT_TRAY_ICON)
    for directory in (_PACKAGE, _ICON_DIR):
        for candidate in (filename, DEFAULT_TRAY_ICON):
            path = directory / candidate
            if path.is_file():
                return str(path)
    return ''


def app_command(flag):
    """Use the same package/Python as this tray, even from a source checkout."""
    env = dict(os.environ)
    existing = env.get('PYTHONPATH')
    env['PYTHONPATH'] = str(_PACKAGE.parent) + (os.pathsep + existing if existing else '')
    # Explicit Qt entry during migration; also accepted after Qt is default.
    return [sys.executable, '-m', 'rogcontrol', '--qt', flag], env


def spawn(argv, env=None):
    try:
        subprocess.Popen(argv, env=dict(os.environ if env is None else env),
                         start_new_session=True)
        return True
    except OSError as error:
        print(f'rogcontrol-tray: could not run {argv[0]}: {error}', file=sys.stderr)
        return False


class ProfileRequestSignals(QObject):
    completed = Signal(object, str, object)


def request_profile_in_background(signals, name):
    fresh = None
    requested = ''
    error = None
    try:
        fresh = config_mod.load_config()
        if name != fresh.get('current_profile'):
            profile_requests.request_profile(name, origin='decky')
            requested = name
    except Exception as failure:
        error = failure
    try:
        signals.completed.emit(fresh, requested, error)
    except RuntimeError:
        # QApplication may already have destroyed the bridge during shutdown.
        pass


class Tray(QObject):
    def __init__(self):
        super().__init__()
        self.app = QApplication.instance()
        if self.app is None:
            raise RuntimeError('Create QApplication before the tray')
        self.app.setQuitOnLastWindowClosed(False)
        self.config = config_mod.load_config()
        self._last_config_mtime = config_mod.config_mtime()
        self.user_quit = False
        self._closed = False
        self._request_pending = False
        self._request_signals = ProfileRequestSignals(self.app)
        self._request_signals.completed.connect(
            self._on_profile_completed, Qt.ConnectionType.QueuedConnection)
        self._items = {}
        self._shown = []
        self._icon_profile = None
        self.indicator = QSystemTrayIcon(self.app)
        self.indicator.activated.connect(self._on_activated)
        self._update_icon(self.config.get('current_profile'), force=True)
        self._build_menu()
        self._host_available = False
        self._check_host()
        if not self._host_available:
            print('rogcontrol-tray: no system tray host yet; waiting for the desktop tray. '
                  'GNOME needs AppIndicator/KStatusNotifierItem support.', file=sys.stderr)
        self.timer = QTimer(self.indicator)
        self.timer.timeout.connect(self._poll)
        self.timer.start(POLL_SECONDS * 1000)

    def _check_host(self):
        available = QSystemTrayIcon.isSystemTrayAvailable()
        if available and not self._host_available:
            self.indicator.show()
        self._host_available = available

    def _stock_profiles(self):
        return [name for name in self.config.get('profiles', {}) if name in DEFAULT_PROFILES]

    def _build_menu(self):
        old_menu = getattr(self, 'menu', None)
        old_group = getattr(self, '_group', None)
        self.menu = QMenu()
        self._group = QActionGroup(self.menu)
        self._shown = self._stock_profiles()
        self._items = {}
        self.menu.addAction('Show window', self._on_show)
        if self._shown:
            self.menu.addSeparator()
        for name in self._shown:
            action = QAction(name, self.menu)
            action.setCheckable(True)
            self._group.addAction(action)
            action.triggered.connect(lambda checked, selected=name: self._on_profile(selected))
            self.menu.addAction(action)
            self._items[name] = action
        if self._shown:
            self.menu.addSeparator()
        self.menu.addAction('Quit', self._on_quit)
        self._sync_menu(self.config.get('current_profile'))
        self.indicator.setContextMenu(self.menu)
        if old_menu is not None:
            old_menu.deleteLater()
        # QActionGroup belongs to its menu and is cleaned up with that menu.
        del old_group

    def _sync_menu(self, current):
        # Allow no checked stock profile when a user-created profile is active.
        self._group.setExclusive(False)
        for name, action in self._items.items():
            action.setChecked(name == current)
        self._group.setExclusive(True)

    def _update_icon(self, current, force=False):
        if force or self._icon_profile != current:
            self._icon_profile = current
            path = icon_for_profile(current)
            self.indicator.setIcon(QIcon(path) if path else QIcon.fromTheme('computer'))
        self.indicator.setToolTip(f'ROG Control — {current or "No profile"}')

    def _on_profile(self, name):
        if self._closed:
            return
        self._sync_menu(self.config.get('current_profile'))
        if self._request_pending:
            return
        self._request_pending = True
        # A daemon thread cannot hold the sidecar open on a contested lock.
        # It touches no widgets; completion is queued to this QObject's thread.
        threading.Thread(target=request_profile_in_background,
                         args=(self._request_signals, name), daemon=True).start()

    @Slot(object, str, object)
    def _on_profile_completed(self, _fresh, requested, error):
        if self._closed:
            return
        self._request_pending = False
        # Only polling publishes config together with its observed mtime.
        # The worker snapshot predates the request and may now be stale.
        self._sync_menu(self.config.get('current_profile'))
        if error is not None:
            self.indicator.setToolTip(f'ROG Control — {error}')
            print(f'rogcontrol-tray: profile request failed: {error}', file=sys.stderr)
        elif requested:
            self.indicator.setToolTip(f'ROG Control — requested {requested}')

    def _on_activated(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            self._on_show()

    def _on_show(self):
        argv, env = app_command('--toggle')
        spawn(argv, env)

    def _on_quit(self):
        argv, env = app_command('--quit')
        spawn(argv, env)
        self.user_quit = True
        self.stop()

    def stop(self, *_args):
        self._closed = True
        self.timer.stop()
        self.indicator.hide()
        self.app.quit()

    def _poll(self):
        self._check_host()
        try:
            mtime = config_mod.config_mtime()
            if not config_mod.config_file_moved_on(self._last_config_mtime, mtime):
                return
            fresh = config_mod.load_config()
            self.config = fresh
            self._last_config_mtime = mtime
            current = fresh.get('current_profile')
            if self._stock_profiles() != self._shown:
                self._build_menu()
            else:
                self._sync_menu(current)
            self._update_icon(current)
        except (OSError, ValueError) as error:
            # A transient read error must not turn into a systemd restart loop.
            self.indicator.setToolTip(f'ROG Control — cannot refresh: {error}')
            print(f'rogcontrol-tray: cannot refresh config: {error}', file=sys.stderr)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName('ROG Control tray')
    tray = Tray()
    for sig in (signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, tray.stop)
    # Return to Python regularly so SIGTERM also works on an idle Qt loop.
    heartbeat = QTimer()
    heartbeat.timeout.connect(lambda: None)
    heartbeat.start(250)
    app.exec()
    return QUIT_EXIT_CODE if tray.user_quit else 0


if __name__ == '__main__':
    sys.exit(main())
