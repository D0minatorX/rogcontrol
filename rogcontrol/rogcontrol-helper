#!/bin/bash
# rogcontrol-helper
# Must live at /usr/local/bin/rogcontrol-helper, owned by root, mode 755.
# Only ever invoked via the sudoers rule set up for it. Every value is
# validated against a hard safety range before anything is written.

set -e

# Prefer a locally built copy, else whatever is on PATH (the AUR package
# installs to /usr/bin). Hardcoding one path meant a perfectly good
# packaged ryzenadj was ignored.
if [ -x /usr/local/bin/ryzenadj ]; then
    RYZENADJ=/usr/local/bin/ryzenadj
else
    RYZENADJ="$(command -v ryzenadj 2>/dev/null || echo /usr/local/bin/ryzenadj)"
fi

is_int() { [[ "$1" =~ ^[0-9]+$ ]]; }
is_signed_int() { [[ "$1" =~ ^-?[0-9]+$ ]]; }

# Where rogauracore actually is, as seen by root.
#
# `command -v` alone was not enough. This script runs under sudo, whose
# secure_path decides root's PATH, and on some distributions that path does
# NOT include /usr/local/bin -- which is exactly where the installer puts
# rogauracore when it comes from upstream's prebuilt release rather than from
# a distribution package (there is no package for it outside the AUR). The
# binary was installed, present and executable, and the keyboard still
# answered "rogauracore is not installed".
find_rogauracore() {
    local found
    if found=$(command -v rogauracore 2>/dev/null); then
        echo "$found"
        return 0
    fi
    for found in /usr/local/bin/rogauracore /usr/bin/rogauracore; do
        if [ -x "$found" ]; then
            echo "$found"
            return 0
        fi
    done
    return 1
}

# Run rogauracore, retrying once on a busy USB claim. Seen right at boot,
# when a kernel-side interface claim (HID enumeration) can still be
# settling: rogauracore's own libusb claim is refused rather than queued,
# so a call landing in that instant fails outright with no keyboard colour
# ever applied. Same reasoning as the ryzenadj retry below: a transient
# race clears on its own and succeeds the second time, a real failure
# (wrong device, no permissions) fails the same way twice, so this is
# exactly one retry, not a loop. The gap is short (0.3s) because releasing
# a USB interface is near-instant, unlike the multi-second SMU mailbox
# contention SMU_LOCK_WAIT guards against further down.
run_rogauracore() {
    local out rc attempt
    for attempt in 1 2; do
        out=$("$@" 2>&1)
        rc=$?
        if [ "$rc" -eq 0 ]; then
            printf '%s\n' "$out"
            return 0
        fi
        if [ "$attempt" -eq 1 ] && printf '%s' "$out" | grep -qi 'LIBUSB_ERROR_BUSY\|Could not claim interface'; then
            sleep 0.3
            continue
        fi
        printf '%s\n' "$out" >&2
        return "$rc"
    done
}

find_hwmon_by_name() {
    for d in /sys/class/hwmon/hwmon*; do
        if [ -f "$d/name" ] && [ "$(cat "$d/name")" == "$1" ]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

usage() {
    echo "Usage: rogcontrol-helper <cpu|cpuboost|cpuepp|cpuclock|cpuminclock|cpuppt|cpufwlimits|gpu|nvboost|nvtemp|gpuclocklimit|fan|kbd|kbdrgb|kbdrgb_brightness|charge|bootsound|panelod|psr|asusd_status|asusd_disable|asusd_enable|supergfxd_enable> ..." >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Serialising the SMU.
#
# ryzenadj drives the SMU through its mailbox. On a machine with no
# ryzen_smu kernel module -- this one -- it gets there through /dev/mem, and
# nothing in that path arbitrates between processes. Two ryzenadj runs at
# once therefore interleave their mailbox transactions and BOTH lose: the
# measured result is "set_tctl_temp is rejected by SMU" / "PCI Bus is not
# writeable" and exit 255, with the machine left half-configured (the power
# limits applied, tctl-temp and coall not). It happens in ordinary use
# because the background enforcer re-applies the CPU limits every 60 seconds
# while the window and the profile-cycle hotkey apply on demand; ten
# concurrent pairs run by hand produced three to seven such failures.
#
# So the cpu action takes an exclusive lock and concurrent callers queue.
# Only cpu. Every other action here reaches its hardware through a kernel
# driver that already serialises writers -- sysfs (cpufreq, hwmon, asus-wmi,
# power_supply) is serialised per write by the kernel, nvidia-smi goes
# through the NVIDIA driver's own ioctl locking, and the asusd actions go
# through systemd -- so none of them can interleave the way the /dev/mem
# mailbox does. Two callers racing there settle on one of the two values,
# which is the same outcome as calling twice in a row. The fan curve is
# deliberately left alone as well: its writes are spaced 8 seconds apart by
# the callers, and putting them behind this lock would let a CPU apply
# delay that cadence. kbdrgb reaches the keyboard over USB via rogauracore,
# which claims the interface exclusively through libusb -- a second one is
# refused by the kernel rather than allowed to interleave -- and sharing
# this lock would make a keyboard colour change queue behind a CPU apply.
SMU_LOCK_WAIT=5

# Where the lock file lives. /run is a root-owned tmpfs: nobody else can
# pre-create the file, and it cannot survive a reboot as a stale leftover.
# /var/lock is the fallback for a system without /run.
#
# ROGCONTROL_HELPER_LOCK_DIR exists so the test suite can exercise the
# locking without root, and is honoured ONLY when not running as root -- the
# real thing runs under sudo, where an environment variable must never be
# able to point a root-owned write somewhere of the caller's choosing.
smu_lock_file() {
    local d
    if [ "$(id -u)" != 0 ] && [ -n "${ROGCONTROL_HELPER_LOCK_DIR:-}" ] \
       && [ -d "$ROGCONTROL_HELPER_LOCK_DIR" ] && [ -w "$ROGCONTROL_HELPER_LOCK_DIR" ]; then
        printf '%s\n' "$ROGCONTROL_HELPER_LOCK_DIR/rogcontrol-helper.lock"
        return 0
    fi
    for d in /run /var/lock; do
        if [ -d "$d" ] && [ -w "$d" ]; then
            printf '%s\n' "$d/rogcontrol-helper.lock"
            return 0
        fi
    done
    return 1
}

# Hold the lock for the rest of this action. flock on a file descriptor, not
# a hand-rolled lockfile: the kernel drops it when this process dies, so a
# crashed or killed helper -- or a crashed ryzenadj, which inherits fd 9 and
# so holds the lock for its own run -- cannot leave a stale lock behind.
#
# The wait is bounded. A caller that cannot get in within SMU_LOCK_WAIT
# seconds is told so and stops, rather than sitting there until its own
# subprocess timeout kills it with no explanation (the window allows 10
# seconds per helper call, the enforcer 30).
#
# If there is nowhere to put the lock, or no flock to take it with, the
# action still runs: that is exactly today's behaviour, and refusing to
# apply a CPU limit because a lock file could not be created would turn a
# missing convenience into a broken machine. Neither can happen under sudo
# on a systemd machine, where /run and util-linux are both always there.
take_smu_lock() {
    local file
    file=$(smu_lock_file) || return 0
    command -v flock >/dev/null 2>&1 || return 0
    { exec 9>>"$file"; } 2>/dev/null || return 0
    if ! flock -w "$SMU_LOCK_WAIT" 9; then
        echo "another rogcontrol CPU apply is in progress (waited ${SMU_LOCK_WAIT}s); nothing was changed" >&2
        exit 1
    fi
    return 0
}

# A separate, short-wait lock for the fan action only -- NOT the SMU lock
# above, and deliberately so: the comment on SMU_LOCK_WAIT explains why a CPU
# apply must never make a fan write wait behind it. This exists for a
# different race: the GUI, the enforcer's periodic full-apply, and the
# cycle-profile hotkey each send one channel's 8-point curve as a single
# helper call, but nothing stops two of those calls landing for the same
# channel at once (a GUI apply racing the enforcer, say) -- the kernel
# serialises each individual sysfs write, not the 8-point sequence, so an
# interleaving there can leave a channel showing a mix of two different
# curves' points. The wait is kept short because these calls are already rare
# and brief; a caller that cannot get in just proceeds unlocked rather than
# fail a fan write over a lock file that could not be created.
FAN_LOCK_WAIT=2
take_fan_lock() {
    local file
    file=$(smu_lock_file) || return 0
    file="${file}.fan"
    command -v flock >/dev/null 2>&1 || return 0
    { exec 8>>"$file"; } 2>/dev/null || return 0
    flock -w "$FAN_LOCK_WAIT" 8 2>/dev/null
    return 0
}

# The asusd actions take no arguments at all: the unit name is written into
# this script and never comes from the caller. Anything extra is a caller
# that thinks it is passing a unit name, and is refused rather than ignored.
no_args() {
    NAME="$1"; shift
    [ "$#" -eq 0 ] || { echo "$NAME takes no arguments" >&2; exit 1; }
}

case "$1" in
    cpu)
        shift
        STAPM="$1"; FAST="$2"; SLOW="$3"; TEMP="$4"; COALL="$5"
        for v in "$STAPM" "$FAST" "$SLOW" "$TEMP"; do
            is_int "$v" || { echo "Invalid numeric value: $v" >&2; exit 1; }
        done
        is_signed_int "$COALL" || { echo "Invalid coall value: $COALL" >&2; exit 1; }
        [ "$STAPM" -ge 15000 ] && [ "$STAPM" -le 150000 ] || { echo "stapm-limit out of safe range (15000-150000)" >&2; exit 1; }
        [ "$FAST" -ge 15000 ] && [ "$FAST" -le 165000 ] || { echo "fast-limit out of safe range (15000-165000)" >&2; exit 1; }
        [ "$SLOW" -ge 15000 ] && [ "$SLOW" -le 150000 ] || { echo "slow-limit out of safe range (15000-150000)" >&2; exit 1; }
        [ "$TEMP" -ge 60 ] && [ "$TEMP" -le 100 ] || { echo "tctl-temp out of safe range (60-100)" >&2; exit 1; }
        [ "$COALL" -ge -30 ] && [ "$COALL" -le 0 ] || { echo "coall out of safe range (-30 to 0)" >&2; exit 1; }
        # One retry, then give up. On a machine with no ryzen_smu module --
        # this one -- ryzenadj reaches the SMU mailbox through /dev/mem, and
        # that path occasionally loses a race with whatever else is touching
        # the mailbox: the identical call succeeds a moment later. Nine such
        # failures were logged over three days while ten consecutive manual
        # runs all passed.
        #
        # Exactly one retry. A real failure (secure boot, an unsupported
        # model, no /dev/mem) fails the same way twice, so a loop would only
        # postpone the report and hold the caller open while it did. The
        # first attempt's output is dropped because a first attempt that is
        # about to be retried has nothing to say; the second attempt runs
        # with its streams untouched, so what it prints is what the caller
        # reports. Nothing above this line changes -- every value has already
        # been range-checked, and the retry re-runs the same checked values.
        #
        # Serialise from here down, after the range checks: a call with a
        # bad value is refused immediately instead of queueing behind
        # somebody else's apply to be refused later. The lock covers both
        # attempts of the retry, so the retry is a retry of the whole
        # exclusive apply and not a second racer.
        take_smu_lock
        RYZENADJ_ARGS=(--stapm-limit="$STAPM" --fast-limit="$FAST"
                       --slow-limit="$SLOW" --tctl-temp="$TEMP"
                       --set-coall="$COALL")
        if "$RYZENADJ" "${RYZENADJ_ARGS[@]}" >/dev/null 2>&1; then
            exit 0
        fi
        sleep 0.3
        exec "$RYZENADJ" "${RYZENADJ_ARGS[@]}"
        ;;

    cpuboost)
        # Turbo/boost on or off, through cpufreq. Turning it off pins every
        # core at its base clock, which removes the millisecond-long boost
        # spikes that the embedded controller reads as 85-90 C -- measured on
        # this machine, those spikes are what make the fans surge while
        # k10temp still reports 57-60 C. Costs peak single-thread speed.
        shift
        VAL="$1"
        [ "$VAL" = "0" ] || [ "$VAL" = "1" ] || {
            echo "cpuboost takes 0 (off) or 1 (on), got: $VAL" >&2; exit 1; }
        GLOBAL=/sys/devices/system/cpu/cpufreq/boost
        if [ -e "$GLOBAL" ]; then
            echo "$VAL" > "$GLOBAL"
            exit 0
        fi
        # amd-pstate exposes one global switch, but acpi-cpufreq and the
        # intel drivers expose it per policy, so fall back to those.
        WROTE=0
        FAILED=""
        for p in /sys/devices/system/cpu/cpufreq/policy*/boost; do
            [ -e "$p" ] || continue
            # Each policy is an independent core: one write failing (a locked
            # or read-only policy) must not, via set -e, abort the loop and
            # leave later cores at the old value with no report of which core
            # was skipped -- so failures are collected instead of fatal here.
            if echo "$VAL" > "$p" 2>/dev/null; then
                WROTE=1
            else
                FAILED="$FAILED $p"
            fi
        done
        if [ -n "$FAILED" ]; then
            echo "failed to write boost on:$FAILED" >&2
        fi
        if [ "$WROTE" = 1 ]; then
            [ -z "$FAILED" ] && exit 0
            exit 1
        fi
        # intel_pstate in active mode has neither of the above -- it
        # publishes no_turbo instead, meaning the opposite: 1 turns turbo
        # OFF. This is the last fallback, reached only when the two cpufreq
        # switches above do not exist, so an AMD machine never gets here.
        NO_TURBO=/sys/devices/system/cpu/intel_pstate/no_turbo
        if [ -e "$NO_TURBO" ]; then
            if [ "$VAL" = "1" ]; then
                echo 0 > "$NO_TURBO"
            else
                echo 1 > "$NO_TURBO"
            fi
            exit 0
        fi
        echo "no cpufreq boost control on this machine" >&2
        exit 1
        ;;

    cpuclock)
        # Ceiling on core clock, in kHz, written to every cpufreq policy.
        # This is a maximum only: cores still drop as low as the governor
        # wants when there is nothing to do, so idle power is unaffected.
        #
        # "max" restores the hardware maximum, which is how a profile says
        # "no limit" -- without it, switching from a limited profile to an
        # unlimited one would leave the old cap in place.
        #
        # Measured on a G614PR: the kernel stores the requested value
        # verbatim on all 32 policies, no rounding to a CPPC step.
        shift
        VAL="$1"
        POLICIES=(/sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq)
        [ -e "${POLICIES[0]}" ] || {
            echo "no cpufreq policies on this machine" >&2; exit 1; }
        P0=$(dirname "${POLICIES[0]}")
        HW_MAX=$(cat "$P0/cpuinfo_max_freq")
        if [ "$VAL" = "max" ]; then
            VAL="$HW_MAX"
        else
            is_int "$VAL" || { echo "Invalid clock (kHz): $VAL" >&2; exit 1; }
            HW_MIN=$(cat "$P0/cpuinfo_min_freq")
            [ "$VAL" -le "$HW_MAX" ] || {
                echo "clock $VAL kHz above this CPU's maximum ($HW_MAX)" >&2; exit 1; }
            [ "$VAL" -ge "$HW_MIN" ] || {
                echo "clock $VAL kHz below this CPU's minimum ($HW_MIN)" >&2; exit 1; }
            # The ceiling cannot sit under the floor. Lower the floor to match
            # rather than letting the kernel silently reject the write.
            for m in /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq; do
                [ -e "$m" ] || continue
                CUR_MIN=$(cat "$m")
                if [ "$CUR_MIN" -gt "$VAL" ]; then
                    echo "$VAL" > "$m" 2>/dev/null || \
                        echo "failed to lower floor on $m" >&2
                fi
            done
        fi
        # Best-effort across policies, same as cpuboost above: each policy is
        # an independent core, so one failing write is reported and skipped
        # rather than -- via set -e -- aborting the loop and leaving later
        # cores at the old ceiling with no report of which core was missed.
        FAILED=""
        for f in "${POLICIES[@]}"; do
            [ -e "$f" ] || continue
            echo "$VAL" > "$f" 2>/dev/null || FAILED="$FAILED $f"
        done
        if [ -n "$FAILED" ]; then
            echo "failed to write clock ceiling on:$FAILED" >&2
            exit 1
        fi
        ;;

    cpuminclock)
        # Floor under the core clock, in kHz, written to every cpufreq policy.
        # The counterpart of cpuclock, and it must be written AFTER it -- see
        # hardware.CPU_APPLY_STEPS. Two separate reasons, both measured:
        #
        #   * a cpufreq "boost" write refreshes every policy, and that resets
        #     scaling_min_freq the same way it resets scaling_max_freq, so a
        #     floor written before boost is gone;
        #   * cpuclock itself lowers scaling_min_freq on any policy whose
        #     floor would sit above the new ceiling (it has to -- the kernel
        #     clamps min to max silently), so a floor written before the
        #     ceiling can be pulled down by it.
        #
        # What the floor actually does: on amd-pstate it becomes the CPPC
        # request's min_perf, which the hardware honours whenever it has the
        # power budget to. It is a floor on the requested clock, NOT a
        # guarantee of it -- with the package pinned at its STAPM limit under
        # all-core load the SMU will run below the floor, because it cannot
        # spend watts it has not got. Raise STAPM if that is the case; there
        # is no cpufreq write that beats a power limit.
        shift
        VAL="$1"
        POLICIES=(/sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq)
        [ -e "${POLICIES[0]}" ] || {
            echo "no cpufreq policies on this machine" >&2; exit 1; }
        P0=$(dirname "${POLICIES[0]}")
        HW_MIN=$(cat "$P0/cpuinfo_min_freq")
        HW_MAX=$(cat "$P0/cpuinfo_max_freq")
        # A flag rather than an empty VAL: an empty argument is a caller bug,
        # not a request for the default, and must not quietly mean one.
        RESTORE=0
        if [ "$VAL" = "min" ]; then
            # "no floor", the way "max" means "no ceiling" for cpuclock. NOT
            # cpuinfo_min_freq: on amd-pstate the driver's own resting floor
            # is amd_pstate_lowest_nonlinear_freq (1.49 GHz on a G614PR
            # against a 0.42 GHz hardware minimum), and writing the hardware
            # minimum here would leave the machine idling lower than it does
            # untouched -- which is a change, not a restore. Resolved per
            # policy in the loop below, since the two files are per policy.
            RESTORE=1
        else
            is_int "$VAL" || { echo "Invalid clock (kHz): $VAL" >&2; exit 1; }
            [ "$VAL" -le "$HW_MAX" ] || {
                echo "floor $VAL kHz above this CPU's maximum ($HW_MAX)" >&2; exit 1; }
            [ "$VAL" -ge "$HW_MIN" ] || {
                echo "floor $VAL kHz below this CPU's minimum ($HW_MIN)" >&2; exit 1; }
        fi
        FAILED=""
        for f in "${POLICIES[@]}"; do
            [ -e "$f" ] || continue
            D=$(dirname "$f")
            if [ "$RESTORE" = 1 ]; then
                if [ -r "$D/amd_pstate_lowest_nonlinear_freq" ]; then
                    THIS=$(cat "$D/amd_pstate_lowest_nonlinear_freq")
                else
                    THIS=$(cat "$D/cpuinfo_min_freq")
                fi
            else
                THIS="$VAL"
                # The floor cannot sit above the ceiling. The kernel accepts
                # such a write and then silently clamps the floor down to the
                # ceiling, so reading scaling_min_freq back would agree with
                # us while meaning something else; clamp here instead, and
                # say so, so the number written is the number in effect.
                CUR_MAX=$(cat "$D/scaling_max_freq")
                if [ "$THIS" -gt "$CUR_MAX" ]; then
                    THIS="$CUR_MAX"
                fi
            fi
            # Best-effort across policies -- see cpuboost/cpuclock above for
            # why a single failing core must not, via set -e, abort the rest.
            echo "$THIS" > "$f" 2>/dev/null || FAILED="$FAILED $f"
        done
        if [ -n "$FAILED" ]; then
            echo "failed to write clock floor on:$FAILED" >&2
            exit 1
        fi
        if [ "$RESTORE" = 0 ]; then
            CUR_MAX=$(cat "$P0/scaling_max_freq")
            [ "$VAL" -le "$CUR_MAX" ] || echo \
                "floor $VAL kHz is above the clock ceiling ($CUR_MAX kHz); held at the ceiling" >&2
        fi
        ;;

    cpuppt)
        # Intel's equivalent of the "cpu" action's four ryzenadj limits: PL1
        # (sustained) and PL2 (short-term boost), in watts, through asus-wmi's
        # ppt_pl1_spl/ppt_pl2_sppt when this firmware exposes them, or RAPL's
        # constraint_0/1_power_limit_uw otherwise.
        #
        # No SMU lock here, unlike "cpu" above: both paths go through a
        # kernel driver (asus-wmi's sysfs store, or the powercap subsystem),
        # and a kernel driver already serialises writes to one file. The
        # /dev/mem race the SMU lock exists for is specific to ryzenadj
        # reaching the mailbox with no ryzen_smu module, which does not
        # happen here.
        shift
        PL1="$1"; PL2="$2"
        is_int "$PL1" || { echo "Invalid PL1: $PL1" >&2; exit 1; }
        is_int "$PL2" || { echo "Invalid PL2: $PL2" >&2; exit 1; }
        [ "$PL1" -ge 5 ] && [ "$PL1" -le 150 ] || { echo "PL1 out of safe range (5-150 W)" >&2; exit 1; }
        [ "$PL2" -ge 5 ] && [ "$PL2" -le 150 ] || { echo "PL2 out of safe range (5-150 W)" >&2; exit 1; }
        # A PL2 below PL1 is a pair the firmware rejects outright on every
        # machine that has been checked against this, not a preference this
        # helper is imposing -- refused here rather than sent to fail less
        # legibly on the other side.
        [ "$PL2" -ge "$PL1" ] || { echo "PL2 ($PL2 W) must be at least PL1 ($PL1 W)" >&2; exit 1; }
        PL1_NODE=/sys/devices/platform/asus-nb-wmi/ppt_pl1_spl
        PL2_NODE=/sys/devices/platform/asus-nb-wmi/ppt_pl2_sppt
        if [ -w "$PL1_NODE" ] && [ -w "$PL2_NODE" ]; then
            echo "$PL1" > "$PL1_NODE"
            echo "$PL2" > "$PL2_NODE"
            exit 0
        fi
        # RAPL fallback. ASUS firmware frequently locks the constraint
        # files -- the write either errors outright or is silently reverted
        # -- so unlike every sysfs write above, this one is verified by
        # reading the value back rather than trusted on a zero exit.
        RAPL_BASE=""
        for z in /sys/class/powercap/intel-rapl:*; do
            [ -d "$z" ] || continue
            case "$z" in *:*:*) continue ;; esac   # a subzone, not the package
            [ -f "$z/name" ] && [ "$(cat "$z/name" | cut -d- -f1)" = "package" ] || continue
            RAPL_BASE="$z"
            break
        done
        [ -n "$RAPL_BASE" ] || {
            echo "no ppt_pl1_spl/ppt_pl2_sppt and no RAPL package zone on this machine" >&2
            exit 1; }
        PL1_UW=$((PL1 * 1000000))
        PL2_UW=$((PL2 * 1000000))
        RAPL_PL1="$RAPL_BASE/constraint_0_power_limit_uw"
        RAPL_PL2="$RAPL_BASE/constraint_1_power_limit_uw"
        [ -w "$RAPL_PL1" ] && [ -w "$RAPL_PL2" ] || {
            echo "no writable RAPL power-limit constraints on this machine" >&2
            exit 1; }
        echo "$PL1_UW" > "$RAPL_PL1"
        echo "$PL2_UW" > "$RAPL_PL2"
        READ_PL1=$(cat "$RAPL_PL1")
        READ_PL2=$(cat "$RAPL_PL2")
        if [ "$READ_PL1" != "$PL1_UW" ] || [ "$READ_PL2" != "$PL2_UW" ]; then
            echo "RAPL power limit write did not take: wrote ${PL1_UW}/${PL2_UW} uW, read back ${READ_PL1}/${READ_PL2} uW -- the firmware likely locks this control" >&2
            exit 1
        fi
        ;;

    cpufwlimits)
        # Hand the CPU power limits back to the firmware.
        #
        # This exists because ryzenadj has no reset. What it writes goes into
        # the SMU and stays there: a profile that simply stops writing its
        # limits leaves the LAST ones it wrote running until the machine is
        # rebooted, so "do not apply the limits" would be a setting with no
        # visible effect at all. What does put the firmware's own numbers
        # back is the firmware being told to reselect its power table, and
        # that is what throttle_thermal_policy (and, on machines without
        # asus-wmi, the generic ACPI platform_profile) is.
        #
        # The value written is the one already there, read a line earlier.
        # asus-wmi's store function does the WMI call unconditionally, so
        # writing back the current mode re-sends the whole table to the EC
        # without changing which mode the user is on -- exactly the "reassert
        # what the firmware wants" this needs, and nothing else.
        #
        # It therefore takes no arguments, and cannot be asked to put the
        # machine on a different power mode: this action can only re-state
        # the mode already selected. That is deliberate. A caller-supplied
        # mode would make this a privileged write to a firmware knob with a
        # value from userspace, which is the shape this helper exists not to
        # have.
        #
        # Side effect worth knowing: the EC reselecting its power table also
        # drops the custom fan curves, exactly as an ordinary power-mode
        # change does. The callers re-push the curves afterwards for the same
        # reason they do after a profile switch.
        shift
        no_args cpufwlimits "$@"
        THROTTLE=/sys/devices/platform/asus-nb-wmi/throttle_thermal_policy
        PLATFORM=/sys/firmware/acpi/platform_profile
        if [ -e "$THROTTLE" ]; then
            # asus-wmi first: it is the ASUS-specific control, and on this
            # hardware it is the one that maps to the firmware's own power
            # table rather than going through whatever the ACPI layer decides
            # to do with it.
            CUR=$(cat "$THROTTLE")
            is_int "$CUR" || {
                echo "throttle_thermal_policy reads '$CUR', which is not a policy number" >&2
                exit 1; }
            echo "$CUR" > "$THROTTLE"
        elif [ -e "$PLATFORM" ]; then
            CUR=$(cat "$PLATFORM")
            [ -n "$CUR" ] || {
                echo "platform_profile is empty" >&2; exit 1; }
            echo "$CUR" > "$PLATFORM"
        else
            echo "no asus-wmi throttle_thermal_policy and no ACPI platform_profile on this machine" >&2
            exit 1
        fi
        ;;

    cpuepp)
        # Energy Performance Preference: how eagerly the governor reaches for
        # high clocks. This is a hint, not a ceiling -- a burst can still hit
        # max clock under any setting -- so it changes average behaviour and
        # battery life rather than capping anything.
        #
        # The valid names come from the kernel itself rather than a hardcoded
        # list, since they differ between amd-pstate and intel_pstate. "custom"
        # is excluded on purpose: it needs a raw 0-255 value written through a
        # different path, and offering it here would just produce confusing
        # failures.
        shift
        PREF="$1"
        [ -n "$PREF" ] || { echo "cpuepp needs a preference name" >&2; exit 1; }
        [ "$PREF" != "custom" ] || {
            echo "cpuepp does not support 'custom'" >&2; exit 1; }
        # BEFORE the name is validated, not after. While the governor is
        # "performance" the kernel shortens
        # energy_performance_available_preferences to that one word, so
        # validating the profile's stored name against that list rejected
        # every legitimate preference -- "invalid EPP preference
        # 'balance_power'; machine offers: performance" on every single
        # apply, logged by the enforcer once a cycle. The name was never
        # invalid; the list was just temporarily one entry long.
        #
        # The kernel rejects an EPP write outright while the governor is
        # "performance", and that is not an error worth reporting: the
        # governor pins every core at maximum performance, so the preference
        # would have nothing to influence. It is also not a state this app
        # chose -- power-profiles-daemon switches the governor to
        # "performance" whenever the OS power mode is set to Performance, so
        # selecting the Performance profile put the machine here.
        #
        # Succeed quietly instead. The profile keeps its stored preference and
        # it takes effect the moment the governor returns to "powersave",
        # which is what happens on the way back to any other profile. Failing
        # here made every Performance apply report an error, and made the
        # background enforcer log one every cycle.
        for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
            [ -e "$g" ] || continue
            if [ "$(cat "$g")" = "performance" ]; then
                echo "governor is 'performance'; EPP has no effect and was not written"
                exit 0
            fi
            break
        done
        AVAIL_FILE=""
        for p in /sys/devices/system/cpu/cpufreq/policy*/energy_performance_available_preferences; do
            [ -e "$p" ] || continue
            AVAIL_FILE="$p"
            break
        done
        [ -n "$AVAIL_FILE" ] || {
            echo "no EPP control on this machine" >&2; exit 1; }
        MATCH=0
        for a in $(cat "$AVAIL_FILE"); do
            [ "$a" = "$PREF" ] && MATCH=1
        done
        [ "$MATCH" = 1 ] || {
            echo "invalid EPP preference '$PREF'; machine offers: $(cat "$AVAIL_FILE")" >&2
            exit 1; }
        WROTE=0
        for p in /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference; do
            [ -e "$p" ] || continue
            echo "$PREF" > "$p"
            WROTE=1
        done
        if [ "$WROTE" = 0 ]; then
            echo "no EPP control on this machine" >&2
            exit 1
        fi
        ;;

    gpu)
        shift
        WATTS="$1"
        is_int "$WATTS" || { echo "Invalid watts: $WATTS" >&2; exit 1; }
        # Generous sanity bound only. The real per-GPU limit is enforced by
        # nvidia-smi itself, which rejects anything outside the card's
        # min/max -- hardcoding one laptop's 140W ceiling here would break
        # every other card.
        [ "$WATTS" -ge 1 ] && [ "$WATTS" -le 1000 ] || { echo "watts out of sane range (1-1000)" >&2; exit 1; }
        exec nvidia-smi -pl "$WATTS"
        ;;

    nvboost)
        # NVIDIA Dynamic Boost, in watts. This is an asus-wmi platform knob,
        # not an nvidia-smi one -- the firmware decides how much of the
        # shared CPU/GPU power budget it may hand to the GPU. Range comes
        # straight from the kernel driver (NVIDIA_BOOST_MIN/MAX in
        # asus-wmi.c); anything outside it is rejected with -EINVAL.
        shift
        VAL="$1"
        NODE=/sys/devices/platform/asus-nb-wmi/nv_dynamic_boost
        is_int "$VAL" || { echo "Invalid dynamic boost: $VAL" >&2; exit 1; }
        [ "$VAL" -ge 5 ] && [ "$VAL" -le 25 ] || { echo "dynamic boost out of range (5-25 W)" >&2; exit 1; }
        [ -w "$NODE" ] || { echo "nv_dynamic_boost not supported on this machine" >&2; exit 1; }
        echo "$VAL" > "$NODE"
        ;;

    nvtemp)
        # GPU temperature target in degrees C. Also an asus-wmi knob; range
        # is NVIDIA_TEMP_MIN/MAX from the kernel driver.
        shift
        VAL="$1"
        NODE=/sys/devices/platform/asus-nb-wmi/nv_temp_target
        is_int "$VAL" || { echo "Invalid temp target: $VAL" >&2; exit 1; }
        [ "$VAL" -ge 75 ] && [ "$VAL" -le 87 ] || { echo "temp target out of range (75-87 C)" >&2; exit 1; }
        [ -w "$NODE" ] || { echo "nv_temp_target not supported on this machine" >&2; exit 1; }
        echo "$VAL" > "$NODE"
        ;;

    gpuclocklimit)
        # Caps the GPU core clock. "reset" restores the default unlocked
        # behaviour. Unlike the clock OFFSET (which nvidia-settings applies
        # on top of the stock curve), this is a hard ceiling via nvidia-smi.
        shift
        VAL="$1"
        if [ "$VAL" = "reset" ]; then
            exec nvidia-smi -rgc
        fi
        is_int "$VAL" || { echo "Invalid clock limit: $VAL" >&2; exit 1; }
        # Sanity bound only -- nvidia-smi enforces the card's actual range.
        [ "$VAL" -ge 100 ] && [ "$VAL" -le 10000 ] || { echo "clock limit out of sane range (100-10000 MHz)" >&2; exit 1; }
        # Some driver versions want an explicit min,max pair and reject a
        # single value, so try the pair form first and fall back.
        nvidia-smi -lgc "0,$VAL" 2>/dev/null || exec nvidia-smi -lgc "$VAL"
        ;;

    fan)
        shift
        CH="$1"; shift
        [[ "$CH" =~ ^[1-3]$ ]] || { echo "Invalid fan channel: $CH (must be 1-3)" >&2; exit 1; }
        if [ "$#" -ne 16 ]; then
            echo "Expected 16 values (8 temp/pwm pairs), got $#" >&2
            exit 1
        fi
        FAN_HWMON=$(find_hwmon_by_name asus_custom_fan_curve) || {
            echo "asus_custom_fan_curve hwmon device not found" >&2
            exit 1
        }
        # See take_fan_lock: closes the window where two callers' 8-point
        # sequences for the same channel could interleave.
        take_fan_lock
        POINT=1
        while [ "$#" -gt 0 ]; do
            T="$1"; P="$2"; shift 2
            is_int "$T" || { echo "Invalid temp: $T" >&2; exit 1; }
            is_int "$P" || { echo "Invalid pwm: $P" >&2; exit 1; }
            [ "$T" -ge 0 ] && [ "$T" -le 100 ] || { echo "temp out of range (0-100): $T" >&2; exit 1; }
            [ "$P" -ge 0 ] && [ "$P" -le 255 ] || { echo "pwm out of range (0-255): $P" >&2; exit 1; }
            # set -e does not catch a failed write inside this loop the way
            # it would a top-level command, so each write is checked by hand:
            # without that, one bad point (a transient EBUSY on the hwmon
            # node, say) would abort here having already written some of this
            # channel's points but not others, and skip the pwm*_enable
            # below -- leaving the channel disabled with a half-written
            # curve and no clear message about which point failed.
            echo "$T" > "$FAN_HWMON/pwm${CH}_auto_point${POINT}_temp" || {
                echo "failed to write point $POINT temp for channel $CH" >&2
                exit 1
            }
            echo "$P" > "$FAN_HWMON/pwm${CH}_auto_point${POINT}_pwm" || {
                echo "failed to write point $POINT pwm for channel $CH" >&2
                exit 1
            }
            POINT=$((POINT + 1))
        done
        # REQUIRED: the asus-wmi custom fan curve interface silently
        # disables itself on every power-profile/mode change (confirmed by
        # the kernel driver's own author -- "the curve is definitely
        # disabled on profile change and will remain disabled until turned
        # on again"). Writing the points alone is not enough; pwm<N>_enable
        # must be explicitly set to 1 ("enable and write settings out")
        # every time, or the BIOS silently ignores everything just written
        # and falls back to its own curve -- this was the real cause of
        # fans never reaching the RPMs the curve asked for.
        echo "1" > "$FAN_HWMON/pwm${CH}_enable" || {
            echo "wrote channel $CH curve but failed to re-enable it" >&2
            exit 1
        }
        ;;

    kbd)
        shift
        LVL="$1"
        is_int "$LVL" || { echo "Invalid level: $LVL" >&2; exit 1; }
        [ "$LVL" -ge 0 ] && [ "$LVL" -le 3 ] || { echo "level out of range (0-3)" >&2; exit 1; }
        echo "$LVL" > /sys/class/leds/asus::kbd_backlight/brightness
        ;;

    kbdrgb)
        # kbdrgb <command> <r 0-255> <g 0-255> <b 0-255> [r2 g2 b2 r3 g3 b3 r4 g4 b4]
        # Delegates to rogauracore, a mature open-source tool with confirmed
        # support for device ID 0b05:19b6 (the N-Key controller on this
        # laptop, verified via `lsusb`) -- this replaces the old direct
        # sysfs write to kbd_rgb_mode, which doesn't exist on this hardware.
        shift
        CMD="$1"; shift
        ROGAURACORE=$(find_rogauracore) || {
            echo "rogauracore is not installed" >&2
            exit 1
        }
        hex2() { printf '%02x' "$1"; }

        case "$CMD" in
            single_static|single_breathing)
                R="$1"; G="$2"; B="$3"
                for v in "$R" "$G" "$B"; do
                    is_int "$v" || { echo "Invalid color value: $v" >&2; exit 1; }
                    [ "$v" -ge 0 ] && [ "$v" -le 255 ] || { echo "color out of range (0-255): $v" >&2; exit 1; }
                done
                HEX="$(hex2 "$R")$(hex2 "$G")$(hex2 "$B")"
                if [ "$CMD" = "single_breathing" ]; then
                    R2="$4"; G2="$5"; B2="$6"
                    for v in "$R2" "$G2" "$B2"; do
                        is_int "$v" || { echo "Invalid second color value: $v" >&2; exit 1; }
                        [ "$v" -ge 0 ] && [ "$v" -le 255 ] || { echo "second color out of range (0-255): $v" >&2; exit 1; }
                    done
                    HEX2="$(hex2 "$R2")$(hex2 "$G2")$(hex2 "$B2")"
                    # single_breathing COLOR1 [COLOR2] [SPEED]. The speed was
                    # never passed, so every position of the speed slider
                    # produced an identical fade. Defaults to 2 when absent so
                    # an older caller still works.
                    SPEED="${7:-2}"
                    is_int "$SPEED" || { echo "Invalid speed: $SPEED" >&2; exit 1; }
                    [ "$SPEED" -ge 1 ] && [ "$SPEED" -le 3 ] || { echo "speed out of range (1-3)" >&2; exit 1; }
                    run_rogauracore "$ROGAURACORE" single_breathing "$HEX" "$HEX2" "$SPEED"
                    exit $?
                else
                    run_rogauracore "$ROGAURACORE" single_static "$HEX"
                    exit $?
                fi
                ;;
            single_pulsing)
                # single_pulsing COLOR SPEED -- rogauracore's actual distinct
                # pulse effect (a sharper on/off flash, not the slow
                # breathing fade). Previously "Pulse" in the UI was faked as
                # single_breathing fading to black, which is visually
                # indistinguishable from Breathing since it's the exact same
                # breathing animation curve, just with a different second
                # color. rogauracore speed range is 1-3, unlike the other
                # commands here which historically used 0-2.
                R="$1"; G="$2"; B="$3"; SPEED="$4"
                for v in "$R" "$G" "$B"; do
                    is_int "$v" || { echo "Invalid color value: $v" >&2; exit 1; }
                    [ "$v" -ge 0 ] && [ "$v" -le 255 ] || { echo "color out of range (0-255): $v" >&2; exit 1; }
                done
                is_int "$SPEED" || { echo "Invalid speed: $SPEED" >&2; exit 1; }
                [ "$SPEED" -ge 1 ] && [ "$SPEED" -le 3 ] || { echo "speed out of range (1-3)" >&2; exit 1; }
                HEX="$(hex2 "$R")$(hex2 "$G")$(hex2 "$B")"
                run_rogauracore "$ROGAURACORE" single_pulsing "$HEX" "$SPEED"
                exit $?
                ;;
            single_colorcycle)
                # Color Cycle takes no color at all -- only a speed. It was
                # previously falling into the same branch as single_static/
                # single_breathing, which validated R/G/B first regardless
                # of command, so an empty/missing color slot always failed
                # with "Invalid color value" even though none was needed.
                SPEED="$1"
                is_int "$SPEED" || { echo "Invalid speed: $SPEED" >&2; exit 1; }
                [ "$SPEED" -ge 1 ] && [ "$SPEED" -le 3 ] || { echo "speed out of range (1-3)" >&2; exit 1; }
                run_rogauracore "$ROGAURACORE" single_colorcycle "$SPEED"
                exit $?
                ;;
            multi_static)
                # multi_static COLOR1 COLOR2 COLOR3 COLOR4 -- one color per
                # keyboard zone (confirmed rogauracore signature).
                ARGS=("$@")
                HEXES=""
                for i in 0 1 2 3; do
                    base=$(( i * 3 ))
                    R="${ARGS[$base]}"
                    G="${ARGS[$((base + 1))]}"
                    B="${ARGS[$((base + 2))]}"
                    for v in "$R" "$G" "$B"; do
                        is_int "$v" || { echo "Invalid zone $((i + 1)) color value: $v" >&2; exit 1; }
                        [ "$v" -ge 0 ] && [ "$v" -le 255 ] || { echo "zone $((i + 1)) color out of range (0-255): $v" >&2; exit 1; }
                    done
                    HEXES="$HEXES $(hex2 "$R")$(hex2 "$G")$(hex2 "$B")"
                done
                run_rogauracore "$ROGAURACORE" multi_static $HEXES
                exit $?
                ;;
            multi_breathing)
                # multi_breathing COLOR1 COLOR2 COLOR3 COLOR4 SPEED -- the
                # four zones animate together, cycling through the colours
                # given. Same 12 colour values as multi_static, plus a speed.
                # This is a firmware effect, so it costs nothing to run: no
                # process wakes up to drive the animation.
                ARGS=("$@")
                if [ "${#ARGS[@]}" -ne 13 ]; then
                    echo "Expected 12 color values and a speed, got ${#ARGS[@]}" >&2
                    exit 1
                fi
                HEXES=""
                for i in 0 1 2 3; do
                    base=$(( i * 3 ))
                    R="${ARGS[$base]}"
                    G="${ARGS[$((base + 1))]}"
                    B="${ARGS[$((base + 2))]}"
                    for v in "$R" "$G" "$B"; do
                        is_int "$v" || { echo "Invalid zone $((i + 1)) color value: $v" >&2; exit 1; }
                        [ "$v" -ge 0 ] && [ "$v" -le 255 ] || { echo "zone $((i + 1)) color out of range (0-255): $v" >&2; exit 1; }
                    done
                    HEXES="$HEXES $(hex2 "$R")$(hex2 "$G")$(hex2 "$B")"
                done
                SPEED="${ARGS[12]}"
                is_int "$SPEED" || { echo "Invalid speed: $SPEED" >&2; exit 1; }
                [ "$SPEED" -ge 1 ] && [ "$SPEED" -le 3 ] || { echo "speed out of range (1-3)" >&2; exit 1; }
                run_rogauracore "$ROGAURACORE" multi_breathing $HEXES "$SPEED"
                exit $?
                ;;
            rainbow)
                # rainbow [SPEED] -- same omission as single_breathing above.
                SPEED="${1:-2}"
                is_int "$SPEED" || { echo "Invalid speed: $SPEED" >&2; exit 1; }
                [ "$SPEED" -ge 1 ] && [ "$SPEED" -le 3 ] || { echo "speed out of range (1-3)" >&2; exit 1; }
                run_rogauracore "$ROGAURACORE" rainbow "$SPEED"
                exit $?
                ;;
            off)
                run_rogauracore "$ROGAURACORE" single_static 000000
                exit $?
                ;;
            *)
                echo "Unknown kbdrgb command: $CMD" >&2
                exit 1
                ;;
        esac
        ;;

    kbdrgb_brightness)
        # kbdrgb_brightness <off|low|dim|medium|high|bright|0-3>
        #
        # These are exactly the words rogauracore knows (NAMED_BRIGHTNESSES in
        # its source), plus the numeric 0-3 it also accepts. This used to allow
        # "med" and "full", which rogauracore does NOT recognise: unknown words
        # fall through to strtol(), which returns 0 for non-numeric text, and 0
        # means OFF. So "med" and "full" silently switched the keyboard off
        # instead of setting medium/full brightness.
        #
        # Validating here matters because rogauracore cannot be relied on to
        # report the problem: it exits 0 even for a brightness value it could
        # not interpret.
        shift
        LEVEL="$1"
        ROGAURACORE=$(find_rogauracore) || {
            echo "rogauracore is not installed" >&2
            exit 1
        }
        case "$LEVEL" in
            off|low|dim|medium|high|bright|0|1|2|3)
                run_rogauracore "$ROGAURACORE" brightness "$LEVEL"
                exit $? ;;
            *)
                echo "Invalid brightness level: $LEVEL" >&2
                echo "Must be one of: off low dim medium high bright 0 1 2 3" >&2
                exit 1 ;;
        esac
        ;;

    charge)
        shift
        PCT="$1"
        is_int "$PCT" || { echo "Invalid percentage: $PCT" >&2; exit 1; }
        [ "$PCT" -ge 0 ] && [ "$PCT" -le 100 ] || { echo "percentage out of range (0-100)" >&2; exit 1; }
        # Find the battery rather than assuming BAT0 -- plenty of laptops
        # enumerate theirs as BAT1, where the old hardcoded path silently
        # did nothing.
        BATT=""
        for b in /sys/class/power_supply/*/charge_control_end_threshold; do
            [ -w "$b" ] && { BATT="$b"; break; }
        done
        [ -n "$BATT" ] || { echo "no battery with charge_control_end_threshold found" >&2; exit 1; }
        echo "$PCT" > "$BATT"
        ;;

    bootsound)
        # The chime the firmware plays through the speakers at power-on,
        # before any operating system is running. One asus-wmi file holding
        # one digit.
        #
        # Two fixed values and nothing else, checked the same way cpuboost
        # checks its own: this is a root-owned write to a firmware knob, and
        # the driver answers anything outside 0/1 with -EINVAL, so passing
        # the caller's string through would turn a typo into an unexplained
        # failure -- and would be exactly the kind of unbounded privileged
        # write this helper exists not to have.
        shift
        VAL="$1"
        [ "$VAL" = "0" ] || [ "$VAL" = "1" ] || {
            echo "bootsound takes 0 (off) or 1 (on), got: $VAL" >&2; exit 1; }
        BOOT_SOUND=/sys/devices/platform/asus-nb-wmi/boot_sound
        [ -e "$BOOT_SOUND" ] || {
            echo "no boot_sound control on this machine" >&2; exit 1; }
        echo "$VAL" > "$BOOT_SOUND"
        ;;

    panelod)
        # Panel overdrive: the display's pixel-response boost, one more
        # asus-wmi file holding one digit. Only some models have it -- the
        # driver creates panel_od when the firmware claims the feature -- so
        # the missing-file case is normal here and gets its own sentence
        # rather than a shell redirection error.
        #
        # Two fixed values and nothing else, on the same grounds as
        # bootsound above: a root-owned write to a firmware knob, refused by
        # the driver with -EINVAL for anything outside 0/1, so passing the
        # caller's string through would turn a typo into an unexplained
        # failure and would widen this helper into the unbounded privileged
        # write it exists not to have.
        shift
        VAL="$1"
        [ "$VAL" = "0" ] || [ "$VAL" = "1" ] || {
            echo "panelod takes 0 (off) or 1 (on), got: $VAL" >&2; exit 1; }
        PANEL_OD=/sys/devices/platform/asus-nb-wmi/panel_od
        [ -e "$PANEL_OD" ] || {
            echo "no panel_od control on this machine" >&2; exit 1; }
        echo "$VAL" > "$PANEL_OD"
        ;;

    psr)
        # AMD panel self-refresh, turned off by a kernel boot parameter.
        #
        # Not a sysfs write like bootsound and panelod above: dcdebugmask is
        # read once by amdgpu at module load, so the only way to change it is
        # the kernel command line, and the only way to change that is the
        # bootloader's config. That makes this the one action here that edits
        # a file on the ESP rather than poking a driver, and the one whose
        # failure mode is a machine that does not boot -- so it is written to
        # be restorable at every step.
        #
        # Limine only, deliberately. GRUB and systemd-boot each want a
        # different file in a different format regenerated by a different
        # command, and a half-understood edit to a bootloader config is worse
        # than no feature at all. detect_capabilities gates the switch on the
        # same three things checked again here.
        shift
        VAL="$1"
        [ "$VAL" = "0" ] || [ "$VAL" = "1" ] || {
            echo "psr takes 0 (disabled) or 1 (enabled), got: $VAL" >&2; exit 1; }

        LIMINE_DEFAULT=/etc/default/limine
        [ -f "$LIMINE_DEFAULT" ] || {
            echo "no $LIMINE_DEFAULT on this machine, so the bootloader is not Limine" >&2
            exit 1; }
        command -v limine-update >/dev/null 2>&1 || {
            echo "limine-update is not installed" >&2; exit 1; }
        command -v limine-enroll-config >/dev/null 2>&1 || {
            echo "limine-enroll-config is not installed" >&2; exit 1; }

        # The exact token this app owns. Only ever this one: a dcdebugmask
        # holding some other value was put there by somebody else for some
        # other reason, and silently rewriting it would be this helper taking
        # over a setting it does not understand.
        #
        # 0x610 is DC_DISABLE_PSR (0x10) | DC_DISABLE_PSR_SU (0x200) |
        # DC_DISABLE_REPLAY (0x400). All three, not just the first, because a
        # panel reporting sink PSR ver 3 negotiates PSR2/SU rather than the
        # original PSR, and leaving those two on would leave the code path
        # that WARNs still reachable.
        PSR_PARAM="amdgpu.dcdebugmask=0x610"
        FOREIGN=$(grep -oE 'amdgpu\.dcdebugmask=[^ ]+' "$LIMINE_DEFAULT" \
                  | grep -v "^${PSR_PARAM}$" | head -1)
        [ -z "$FOREIGN" ] || {
            echo "$LIMINE_DEFAULT already sets $FOREIGN, which this app did not put there; refusing to change it" >&2
            exit 1; }

        # Nothing to do is success, not a no-op that still regenerates the
        # bootloader config: re-enrolling a checksum for an unchanged file is
        # a risk taken for no gain.
        if grep -qF "$PSR_PARAM" "$LIMINE_DEFAULT"; then
            HAVE=disabled
        else
            HAVE=enabled
        fi
        WANT=enabled
        [ "$VAL" = "0" ] && WANT=disabled
        [ "$HAVE" != "$WANT" ] || { echo "already $WANT"; exit 0; }

        # The backup is the whole recovery plan, so it is taken before the
        # first byte changes and kept afterwards rather than deleted on
        # success -- the failure this guards against is a boot that does not
        # happen, which cannot be recovered from by anything running here.
        BACKUP="${LIMINE_DEFAULT}.rogcontrol.bak"
        cp -p "$LIMINE_DEFAULT" "$BACKUP" || {
            echo "could not back up $LIMINE_DEFAULT; nothing was changed" >&2
            exit 1; }

        # Written to a temporary file and moved into place, so a failure
        # midway through leaves the original intact rather than truncated.
        TMP=$(mktemp "${LIMINE_DEFAULT}.rogcontrol.XXXXXX") || {
            echo "could not create a temporary file next to $LIMINE_DEFAULT" >&2
            exit 1; }
        trap 'rm -f "$TMP"' EXIT

        if [ "$WANT" = "disabled" ]; then
            # Appended to the pinned KERNEL_CMDLINE line rather than added as
            # a line of its own: limine-entry-tool concatenates every
            # KERNEL_CMDLINE assignment it finds, but this file pins one on
            # purpose (see its own comment), and keeping to that one line
            # leaves the config looking the way its author left it.
            awk -v param="$PSR_PARAM" '
                /^KERNEL_CMDLINE\[default\]\+=/ && !done {
                    print $0 " " param; done = 1; next
                }
                { print }
                END { if (!done) exit 3 }
            ' "$LIMINE_DEFAULT" > "$TMP" || {
                echo "no KERNEL_CMDLINE[default] line in $LIMINE_DEFAULT to append to; nothing was changed" >&2
                exit 1; }
        else
            # Removing: take the token out and tidy the double space it
            # leaves. Addressed to the KERNEL_CMDLINE line and nothing else,
            # because the whitespace tidy-up would otherwise reflow every
            # comment in the file -- this one has a line reading
            # "###   limine-entry-tool --remove-efi-path ...", whose
            # indentation is its author's and not this helper's to collapse.
            sed -e "/^KERNEL_CMDLINE\[default\]+=/{
                        s/ *${PSR_PARAM}//
                        s/  */ /g
                        s/ *\$//
                    }" "$LIMINE_DEFAULT" > "$TMP" || {
                echo "could not rewrite $LIMINE_DEFAULT; nothing was changed" >&2
                exit 1; }
        fi

        cat "$TMP" > "$LIMINE_DEFAULT" || {
            echo "could not write $LIMINE_DEFAULT; nothing was changed" >&2
            exit 1; }

        # Regenerate the boot entries, then re-enroll the checksum Limine
        # verifies them against. The order matters and so does the second
        # step: this ESP has ENABLE_ENROLL_LIMINE_CONFIG=yes, which makes
        # Limine panic at boot on a limine.conf whose hash no longer matches
        # the one embedded in the binary. Leaving the config regenerated but
        # un-enrolled is the one outcome here that costs a boot.
        if ! OUT=$(limine-update 2>&1); then
            cat "$BACKUP" > "$LIMINE_DEFAULT"
            limine-update >/dev/null 2>&1
            limine-enroll-config >/dev/null 2>&1
            echo "limine-update failed, so $LIMINE_DEFAULT was put back: $OUT" >&2
            exit 1
        fi
        if ! OUT=$(limine-enroll-config 2>&1); then
            cat "$BACKUP" > "$LIMINE_DEFAULT"
            limine-update >/dev/null 2>&1
            limine-enroll-config >/dev/null 2>&1
            echo "limine-enroll-config failed, so $LIMINE_DEFAULT was put back: $OUT" >&2
            exit 1
        fi
        echo "$WANT at the next boot"
        ;;

    asusd_status)
        # Reports one of: not-installed, active, inactive-enabled,
        # inactive-disabled -- deliberately narrow (only ever targets the
        # literal unit name "asusd", never a caller-supplied name) so this
        # can't be turned into a generic systemctl-as-root passthrough.
        #
        # The window does not use this: reading a unit's state needs no
        # privilege, so it asks systemctl directly (hardware.read_asusd_state)
        # rather than spending a sudo on a question any user may ask. It stays
        # because install.sh calls it to prove the sudoers rule works.
        shift
        no_args asusd_status "$@"
        if ! systemctl list-unit-files asusd.service >/dev/null 2>&1 \
           || ! systemctl list-unit-files asusd.service 2>/dev/null | grep -q asusd.service; then
            echo "not-installed"
            exit 0
        fi
        if systemctl is-active --quiet asusd.service; then
            echo "active"
        elif systemctl is-enabled --quiet asusd.service 2>/dev/null; then
            echo "inactive-enabled"
        else
            echo "inactive-disabled"
        fi
        ;;

    asusd_disable)
        # Stop asusd and keep it stopped. It drives the same asus-wmi knobs,
        # fan curves and keyboard lighting as this app, so the two re-assert
        # different settings at each other for as long as both are running.
        #
        # Reversible by design: asusd_enable below is the way back, and
        # neither action removes anything.
        shift
        no_args asusd_disable "$@"
        systemctl disable --now asusd.service
        ;;

    asusd_enable)
        # The way back. --now so the service is running again when this
        # returns, rather than only after the next boot.
        shift
        no_args asusd_enable "$@"
        systemctl enable --now asusd.service
        ;;

    supergfxd_enable)
        # Turn on the daemon the graphics-mode picker needs. Some
        # distributions ship the supergfxctl package with its unit installed
        # but not enabled, which leaves the window able to see supergfxctl on
        # PATH while nothing answers -- indistinguishable, from the GPU page,
        # from a broken daemon.
        #
        # Enable-only, on purpose. This app WANTS supergfxd running: without
        # it the mode picker can neither read nor switch. There is no
        # supergfxd_disable to match asusd's, because nothing here would ever
        # ask for one, and a disable primitive sitting in a passwordless
        # helper is worth not having.
        #
        # Same shape as asusd_enable: no arguments at all, and the unit name
        # is written here rather than taken from the caller.
        shift
        no_args supergfxd_enable "$@"
        systemctl enable --now supergfxd.service
        ;;

    # There is deliberately no action that removes the asusctl package.
    # Removing packages is a transaction the user should see, in their own
    # terminal, with its own confirmation and its own dependency list -- the
    # window shows the exact command for the detected distro instead. A root
    # "remove this package" primitive sitting in a passwordless helper is
    # also exactly the kind of thing this helper exists not to have.

    *)
        usage
        ;;
esac
