[Unit]
Description=ROG Control tray icon
After=graphical-session.target
# Without this, logout only implies an ordering, not a stop: the compositor
# can close the display before this unit ever gets a SIGTERM, which crashes
# the tray on a broken pipe (GDK's fatal IO error handler exits 1) and, with
# Restart=always below, sends it straight into a respawn against a session
# slice that is already being torn down -- the "Failed to create cgroup"
# spam. PartOf ties this unit's stop to graphical-session.target's, so it is
# asked to quit, and answers through tray.stop()'s SIGTERM handler, before
# the display underneath it goes away.
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/rogcontrol-tray
Restart=always
RestartSec=3
# 42 is the tray's "the user chose Quit" code -- see QUIT_EXIT_CODE in
# rogcontrol-tray. Restart=always is deliberate and covers the bug this unit
# was written for: the tray was seen exiting 0 with no crash and, under
# Restart=on-failure, staying dead with the icon gone for the rest of the
# session. Everything except a deliberate quit is therefore restarted.
RestartPreventExitStatus=42
# ...and 42 is a normal way to stop, not a crash. Without this the unit sits
# in "failed" after every Quit, which is what someone debugging a genuinely
# broken tray would find first and be misled by.
SuccessExitStatus=42

[Install]
WantedBy=graphical-session.target
